{
  "schemaVersion": 2,
  "id": "telematic-network-diagnostics",
  "name": "Telematic Network Diagnostics",
  "version": "0.7.0",
  "description": "PNDS score project for cross-internet network diagnostics: measures the hub leg (score server to public hub) and the local leg (performer to score server) of a hub/star telematic setup.",
  "telematic": true,
  "scoreServer": {
    "entry": "server.js",
    "workingDirectory": ".",
    "performerPort": 6868,
    "monitorPort": 6869
  },
  "audio": {
    "defaultMode": "none",
    "supportedModes": [
      "none"
    ]
  },
  "sharedLibraries": [
    {
      "id": "express",
      "version": "5.3.0"
    },
    {
      "id": "qrcode",
      "version": "1.5.4"
    },
    {
      "id": "socket.io",
      "version": "4.8.4"
    },
    {
      "id": "socket.io-client",
      "version": "4.8.4"
    }
  ]
}
