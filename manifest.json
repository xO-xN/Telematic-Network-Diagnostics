{
  "schemaVersion": 2,
  "id": "telematic-network-diagnostics",
  "name": "Telematic Network Diagnostics",
  "version": "0.8.1",
  "description": "PNDS internet-only network diagnostics: measures each node to its public HUB and shows linked geographic and topology views.",
  "telematic": true,
  "scoreServer": {
    "entry": "server.js",
    "workingDirectory": ".",
    "performerPort": 6868,
    "monitorPort": 6869,
    "runtimePorts": 1,
    "browserParticipation": 1,
    "supportsPerformerUrl": true
  },
  "audio": {
    "defaultMode": "none",
    "supportedModes": [
      "none"
    ]
  },
  "sharedLibraries": [
    {
      "id": "express",
      "version": "5.3.0"
    },
    {
      "id": "socket.io",
      "version": "4.8.4"
    },
    {
      "id": "socket.io-client",
      "version": "4.8.4"
    }
  ]
}
